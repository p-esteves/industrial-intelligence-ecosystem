# ============================================================
# Industrial Multi-Agent Ecosystem — Environment Configuration
# ============================================================

# ── General & Server Settings ──────────────────────────────────
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://backend_api:8000
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,http://localhost:8000

# ── LLM Provider (ollama local-first) ──────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama_service:11434
OLLAMA_MODEL=phi3:mini

# ── Embeddings Configuration ───────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ── Paths & Anomaly Detection ──────────────────────────────────
DATA_DIR=./data
SAMPLE_DIR=./data/sample
FAISS_INDEX_DIR=./data/.faiss_index
ANOMALY_ZSCORE_THRESHOLD=2.0
ANOMALY_IQR_THRESHOLD=1.5
